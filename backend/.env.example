# Copy to .env and fill in to enable the AI Assistant (POST /api/assistant/chat).
# Without this, the rest of the app works fine — only the AI Assistant tab is disabled.
ANTHROPIC_API_KEY=

# Admin login (gates the whole app except /login and the public Care & Resources
# page). Defaults below let the app run out of the box for the demo — CHANGE
# THEM before any real deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=braintriage2026
JWT_SECRET=change-this-to-a-long-random-string-before-any-real-deployment
